---
// Aquí no necesitamos código de servidor por ahora
---

<div id="cart-drawer" class="fixed inset-0 z-[100] hidden">
    <div id="close-drawer-bg" class="absolute inset-0 bg-pink-900/20 backdrop-blur-sm"></div>
    
    <div class="absolute right-0 top-0 h-full w-full max-w-md bg-white shadow-2xl flex flex-col transform transition-transform duration-300">
        <div class="p-6 border-b border-pink-50 flex justify-between items-center bg-pink-50/30">
            <h2 class="text-2xl font-serif font-bold text-gray-800">Tu Carrito ✨</h2>
            <button id="close-drawer" class="text-gray-400 hover:text-pink-500 text-3xl transition-colors">&times;</button>
        </div>

        <div id="cart-list" class="flex-grow overflow-y-auto p-6 space-y-6">
        </div>

        <div class="p-6 border-t border-pink-50 bg-white">
            <div id="price-summary" class="space-y-2 mb-6">
                <div class="flex justify-between text-gray-500 italic">
                    <span>Subtotal:</span>
                    <span id="cart-subtotal">$0</span>
                </div>
                <div class="flex justify-between text-gray-500 italic">
                    <span>Domicilio:</span>
                    <span id="cart-shipping">$0</span>
                </div>
                <div class="flex justify-between text-xl font-bold text-gray-800 border-t border-pink-50 pt-2">
                    <span>Total:</span>
                    <span id="cart-total" class="text-pink-500">$0</span>
                </div>
            </div>
            
            <button id="whatsapp-order" class="w-full bg-green-500 hover:bg-green-600 text-white py-4 rounded-2xl font-bold text-lg shadow-lg shadow-green-100 transition-all flex justify-center items-center gap-3 active:scale-95">
                <span>Pedir por WhatsApp</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.438 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            </button>
        </div>
    </div>
</div>

<script>
    import { cartItems } from '../store/cartStore';

    const drawer = document.getElementById('cart-drawer');
    const cartList = document.getElementById('cart-list');
    const cartSubtotal = document.getElementById('cart-subtotal');
    const cartShipping = document.getElementById('cart-shipping');
    const cartTotal = document.getElementById('cart-total');
    const whatsappBtn = document.getElementById('whatsapp-order');

    const COSTO_DOMICILIO = 11000;

    cartItems.subscribe((items) => {
        const products = Object.values(items);
        
        if (products.length === 0) {
            cartList.innerHTML = `
                <div class="text-center py-20">
                    <span class="text-5xl block mb-4">🛍️</span>
                    <p class="text-gray-400 font-medium">Tu carrito está vacío</p>
                </div>`;
            cartSubtotal.textContent = "$0";
            cartShipping.textContent = "$0";
            cartTotal.textContent = "$0";
        } else {
            cartList.innerHTML = products.map(item => `
                <div class="flex items-center gap-4 bg-pink-50/20 p-3 rounded-2xl border border-pink-50">
                    <img src="${item.imagen_principal}" class="w-20 h-20 rounded-xl object-cover shadow-sm" />
                    <div class="flex-grow">
                        <h4 class="font-bold text-gray-800 text-sm leading-tight">${item.nombre}</h4>
                        <p class="text-pink-500 font-bold mt-1 text-sm">${item.quantity} x $${Number(item.precio).toLocaleString('es-CO')}</p>
                    </div>
                </div>
            `).join('');

            const subtotal = products.reduce((acc, item) => acc + (item.precio * item.quantity), 0);
            const total = subtotal + COSTO_DOMICILIO;

            cartSubtotal.textContent = `$${subtotal.toLocaleString('es-CO')}`;
            cartShipping.textContent = `$${COSTO_DOMICILIO.toLocaleString('es-CO')}`;
            cartTotal.textContent = `$${total.toLocaleString('es-CO')}`;
        }
    });

    whatsappBtn?.addEventListener('click', () => {
        const products = Object.values(cartItems.get());
        if (products.length === 0) return alert("¡El carrito está vacío!");

        const subtotal = products.reduce((acc, item) => acc + (item.precio * item.quantity), 0);
        const total = subtotal + COSTO_DOMICILIO;
        
        let mensaje = "¡Hola Starla!  Me gustaría hacer un pedido:\n\n";
        products.forEach(p => {
            mensaje += ` ${p.quantity} x ${p.nombre} - $${(p.precio * p.quantity).toLocaleString('es-CO')}\n`;
        });
        
        mensaje += `\n--------------------------`;
        mensaje += `\n Subtotal: $${subtotal.toLocaleString('es-CO')}`;
        mensaje += `\n Domicilio: $${COSTO_DOMICILIO.toLocaleString('es-CO')}`;
        mensaje += `\n*Total a pagar: $${total.toLocaleString('es-CO')}*`;
        
        const numero = "573123456789"; 
        window.open(`https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`, '_blank');
    });

    const toggleDrawer = () => drawer?.classList.toggle('hidden');

    document.getElementById('cart-button')?.addEventListener('click', toggleDrawer);
    document.getElementById('close-drawer')?.addEventListener('click', toggleDrawer);
    document.getElementById('close-drawer-bg')?.addEventListener('click', toggleDrawer);
</script>